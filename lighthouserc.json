{
    "ci": {
        "collect": {
            "staticDistDir": "./resources/public",
            "url": [
                "http://localhost/index.html"
            ],
            "numberOfRuns": 3,
            "settings": {
                "preset": "desktop"
            }
        },
        "assert": {
            "assertions": {
                "categories:performance": [
                    "error",
                    {
                        "minScore": 0.5
                    }
                ],
                "categories:accessibility": [
                    "error",
                    {
                        "minScore": 1
                    }
                ],
                "categories:best-practices": [
                    "error",
                    {
                        "minScore": 1
                    }
                ],
                "categories:seo": [
                    "error",
                    {
                        "minScore": 1
                    }
                ]
            }
        }
    }
}
