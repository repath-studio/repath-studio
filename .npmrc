# @sentry/electron 8.3.0 requires @sentry/core 11.8.0, so package.json forces the
# Sentry JS SDKs to 11.8.0 via overrides. @sentry/capacitor has no release built
# against v11 yet (latest 4.5.0 still pins its siblings to 10.76.2), so its
# postinstall check-siblings.js fails `npm ci` on that mismatch. npm exports this
# project config to lifecycle scripts as npm_config_update_sentry_capacitor, the
# SDK's documented way to skip the check during an intentional sibling bump.
update-sentry-capacitor=true
